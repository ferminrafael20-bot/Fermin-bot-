# Copia este archivo como ".env" (en la carpeta del proyecto) y rellena lo que uses.
# El archivo .env NO se sube a GitHub.

# --- Moneda (CLP = peso chileno) ---
ALFRED_MONEDA=CLP

# --- Si usas Alfred en Windows Y en Mac: pon tus datos en una carpeta sincronizada
#     (Google Drive, iCloud, OneDrive o Dropbox) para tener los mismos gastos y agenda.
#     Ejemplos:  Windows: C:\Users\TuNombre\Google Drive\Alfred
#                Mac:     ~/Library/CloudStorage/GoogleDrive-tucorreo/Mi unidad/Alfred
# ALFRED_DATA_DIR=

# --- Claude (cerebro de Alfred) ---
ANTHROPIC_API_KEY=
# ALFRED_MODEL=claude-opus-5-5
# ALFRED_EFFORT=low

# --- Correo (noticias diarias y avisos) — Gmail con contraseña de aplicación ---
ALFRED_EMAIL_USER=
ALFRED_EMAIL_PASSWORD=
# ALFRED_EMAIL_TO=
# ALFRED_HORA_NOTICIAS=06:00

# --- Avisos un día antes de clases/torneos ---
# ALFRED_HORA_AVISO=10:00

# --- Telegram (hablar con Alfred desde el celular) ---
ALFRED_TELEGRAM_TOKEN=
ALFRED_TELEGRAM_CHAT_ID=

# --- Shopify ---
ALFRED_SHOPIFY_STORE=
ALFRED_SHOPIFY_TOKEN=
