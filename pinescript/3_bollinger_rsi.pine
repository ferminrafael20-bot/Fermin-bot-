//@version=5
// Estrategia 3: Bandas de Bollinger(20,2) + RSI(14) — reversión a la media
// futuros BTC/XRP/XAUT/SOL, timeframe 5m
// Indicadores (2): Bandas de Bollinger (20, 2) y RSI (14).
// Compra: el cierre toca/perfora la banda inferior y el RSI está en
//         sobreventa (< 30) -> posible rebote alcista.
// Venta:  el cierre toca/perfora la banda superior y el RSI está en
//         sobrecompra (> 70) -> posible corrección bajista / short.
strategy("Bollinger(20,2) + RSI(14) - 5m Futuros", shorttitle = "BB+RSI",
     overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     initial_capital = 1000, currency = currency.USDT)

// ---- Inputs ----
bbLen      = input.int(20, "Periodo Bandas de Bollinger", minval = 1)
bbStd      = input.float(2.0, "Desviaciones estándar", minval = 0.1)
rsiLen     = input.int(14, "Periodo RSI", minval = 1)
oversold   = input.float(30, "Nivel de sobreventa")
overbought = input.float(70, "Nivel de sobrecompra")
allowLong  = input.bool(true, "Permitir compras (long)")
allowShort = input.bool(true, "Permitir ventas en corto (short)")

// ---- Indicadores ----
basis = ta.sma(close, bbLen)
dev   = bbStd * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev
rsiVal = ta.rsi(close, rsiLen)

plot(upper, "Banda superior", color = color.new(color.gray, 0))
plot(basis, "Media (20)",     color = color.new(color.gray, 50))
plot(lower, "Banda inferior", color = color.new(color.gray, 0))

// ---- Señales ----
buySignal  = close <= lower and rsiVal < oversold
sellSignal = close >= upper and rsiVal > overbought

if allowLong and buySignal
    strategy.entry("Long", strategy.long)
if allowShort and sellSignal
    strategy.entry("Short", strategy.short)

plotshape(buySignal,  title = "BUY",  text = "BUY",  location = location.belowbar,
     style = shape.triangleup,   color = color.new(color.green, 0), textcolor = color.green, size = size.tiny)
plotshape(sellSignal, title = "SELL", text = "SELL", location = location.abovebar,
     style = shape.triangledown, color = color.new(color.red, 0),   textcolor = color.red,   size = size.tiny)

alertcondition(buySignal,  title = "Bollinger+RSI BUY",  message = "Bollinger(20,2)+RSI(14): señal de COMPRA en {{ticker}} {{interval}}")
alertcondition(sellSignal, title = "Bollinger+RSI SELL", message = "Bollinger(20,2)+RSI(14): señal de VENTA en {{ticker}} {{interval}}")

plot(rsiVal, "RSI(14)", display = display.data_window)
