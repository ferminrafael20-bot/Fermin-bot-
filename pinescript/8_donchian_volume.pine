//@version=5
// Estrategia 8: Ruptura de Canal de Donchian(20) + Volumen — futuros BTC/XRP/XAUT/SOL, 5m
// Indicadores (2): Canal de Donchian (máximo/mínimo de N velas) y SMA de volumen.
// Compra: el cierre rompe por encima del máximo de las últimas N velas con
//         volumen por encima de su media (confirma la ruptura).
// Venta:  el cierre rompe por debajo del mínimo de las últimas N velas con
//         volumen por encima de su media.
// Riesgo: stop-loss y take-profit dinámicos basados en ATR.
strategy("Donchian Breakout + Volumen - 5m Futuros", shorttitle = "Donchian+Vol",
     overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     initial_capital = 1000, currency = currency.USDT,
     commission_type = strategy.commission.percent, commission_value = 0.04,
     slippage = 1, process_orders_on_close = true)

// ---- Inputs: indicador ----
donchLen = input.int(20, "Periodo Canal de Donchian", minval = 1, group = "Indicador")
volLen   = input.int(20, "Periodo media de volumen", minval = 1, group = "Indicador")
volMult  = input.float(1.2, "Volumen mínimo (x media)", minval = 0.1, step = 0.1, group = "Indicador")

// ---- Inputs: filtro de tendencia superior ----
useHtfFilter = input.bool(true, "Filtrar por tendencia de timeframe superior", group = "Filtro de tendencia")
htf          = input.timeframe("60", "Timeframe superior", group = "Filtro de tendencia")

// ---- Inputs: gestión de riesgo ----
atrLen  = input.int(14, "Periodo ATR", minval = 1, group = "Gestión de riesgo")
slMult  = input.float(1.5, "Stop Loss (x ATR)", minval = 0.1, step = 0.1, group = "Gestión de riesgo")
tpMult  = input.float(3.0, "Take Profit (x ATR)", minval = 0.1, step = 0.1, group = "Gestión de riesgo")

allowLong  = input.bool(true, "Permitir compras (long)",  group = "Dirección")
allowShort = input.bool(true, "Permitir ventas en corto (short)", group = "Dirección")

// ---- Indicadores ----
// Canal calculado con las N velas PREVIAS (excluye la vela actual) para que
// la ruptura sea real y no un artefacto de incluir el propio máximo/mínimo.
donchHigh = ta.highest(high[1], donchLen)
donchLow  = ta.lowest(low[1], donchLen)
volAvg    = ta.sma(volume, volLen)
atrVal    = ta.atr(atrLen)
htfTrend  = request.security(syminfo.tickerid, htf, ta.ema(close, 50))

plot(donchHigh, "Canal superior", color = color.new(color.teal, 0))
plot(donchLow,  "Canal inferior", color = color.new(color.maroon, 0))
plot(useHtfFilter ? htfTrend : na, "Tendencia superior", color = color.new(color.purple, 0), linewidth = 2)

// ---- Señales crudas ----
volumeConfirm = volume > volAvg * volMult
buySignal  = ta.crossover(close, donchHigh)  and volumeConfirm
sellSignal = ta.crossunder(close, donchLow)  and volumeConfirm

// ---- Filtro de tendencia superior ----
trendOkLong  = not useHtfFilter or close > htfTrend
trendOkShort = not useHtfFilter or close < htfTrend

// ---- Señales realmente operadas (con filtro) ----
buyEntry  = buySignal  and allowLong  and trendOkLong
sellEntry = sellSignal and allowShort and trendOkShort

if buyEntry
    strategy.entry("Long", strategy.long)
    strategy.exit("Salida Long", "Long", stop = close - slMult * atrVal, limit = close + tpMult * atrVal)

if sellEntry
    strategy.entry("Short", strategy.short)
    strategy.exit("Salida Short", "Short", stop = close + slMult * atrVal, limit = close - tpMult * atrVal)

plotshape(buyEntry,  title = "BUY",  text = "BUY",  location = location.belowbar,
     style = shape.triangleup,   color = color.new(color.green, 0), textcolor = color.green, size = size.tiny)
plotshape(sellEntry, title = "SELL", text = "SELL", location = location.abovebar,
     style = shape.triangledown, color = color.new(color.red, 0),   textcolor = color.red,   size = size.tiny)

alertcondition(buyEntry,  title = "Donchian+Vol BUY",  message = "Donchian Breakout+Volumen: señal de COMPRA en {{ticker}} {{interval}}")
alertcondition(sellEntry, title = "Donchian+Vol SELL", message = "Donchian Breakout+Volumen: señal de VENTA en {{ticker}} {{interval}}")

plot(volAvg, "Media de volumen", display = display.data_window)
