# Copia este archivo a ".env" dentro de functions/ (Firebase Functions v2 lo carga solo).
# Mientras WEBPAY_ENV no sea "production", se usan las credenciales de INTEGRACION
# (pruebas) que Transbank publica oficialmente -- no hace falta configurar nada mas
# para probar pagos de prueba.
WEBPAY_ENV=integration

# Solo se usan si WEBPAY_ENV=production (credenciales reales entregadas por Transbank
# al aprobar tu comercio). Nunca subas estos valores al repositorio.
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# URL publica de la funcion "webpayReturn" luego de desplegar (firebase deploy --only functions).
# Ejemplo: https://us-central1-tu-proyecto.cloudfunctions.net/webpayReturn
WEBPAY_RETURN_URL=
