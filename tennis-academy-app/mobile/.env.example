# Copia este archivo a ".env". Ya viene con la config real del proyecto Firebase
# "rd-tennis-academy" (Configuracion del proyecto > General > Tus apps > SDK de
# Firebase). Estas claves "web" no son secretas -- Firebase las protege con las
# reglas de seguridad (firestore.rules), no ocultandolas -- pero si mas adelante
# creas otro proyecto, reemplazalas por las tuyas.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDLzdzwNdeSh_4VbgyDtaLTd4hBCLjGk80
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=rd-tennis-academy.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=rd-tennis-academy
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=rd-tennis-academy.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=380192251098
EXPO_PUBLIC_FIREBASE_APP_ID=1:380192251098:web:2366fa9852c7ac9b9a59e3

# Region donde desplegaste las Cloud Functions (debe coincidir con la region de
# functions/src/index.ts -- por defecto southamerica-east1)
EXPO_PUBLIC_FUNCTIONS_REGION=southamerica-east1
